# Copy karo -> .env.local, phir values bhar do.

# ---------- Database ----------
# Local development: plain SQLite file (koi extra setup nahi)
DATABASE_URL=file:./data/expenses.db

# ZAROORI: agar project OneDrive / Dropbox / Google Drive folder ke andar hai to
# DB file wahan mat rakho — sync purani copy restore kar deta hai aur rows ud jaate hain.
# Uss soorat me sync folder se bahar ka absolute path do:
# DATABASE_URL=file:C:/Users/<you>/.kharcha/expenses.db

# Production (Vercel): Turso / libSQL — same SQLite engine, sirf URL badalta hai.
# Vercel ka filesystem ephemeral hai, wahan .db file survive nahi karti.
# DATABASE_URL=libsql://your-db-name-you.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi...

# ---------- Timezone ----------
# Saari dates aur monthly totals is timezone ke hisaab se bante hain
APP_TZ=Asia/Karachi

# ---------- Currency (browser me dikhta hai) ----------
NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_LOCALE=en-PK

# ---------- Web Push (daily notification) ----------
# Generate karne ke liye: npm run keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Cron ----------
# Vercel Cron ise automatically Authorization header me bhejta hai.
# Koi bhi lamba random string rakh lo.
CRON_SECRET=change-me-to-a-long-random-string
